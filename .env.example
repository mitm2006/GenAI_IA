# === Database ===
# SQLite (default — works without Docker):
DATABASE_URL=sqlite:///./bi_analytics.db
DB_READONLY_URL=sqlite:///./bi_analytics.db

# PostgreSQL (if you have Docker Desktop installed):
# DATABASE_URL=postgresql://bi_user:bi_password@localhost:5432/bi_analytics
# DB_READONLY_URL=postgresql://bi_readonly:readonly_password@localhost:5432/bi_analytics

# === LLM (Groq hosted inference) ===
# Create a key at https://console.groq.com/keys and keep it server-side only.
# Never copy this value into the frontend or commit it to version control.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3

# Reasoning controls for reasoning-capable models.
# reasoning_format=hidden asks Groq to omit the model's internal reasoning
# entirely; the backend strips any residue regardless of this setting.
LLM_REASONING_FORMAT=hidden
LLM_REASONING_EFFORT=low

EMBEDDING_MODEL=all-MiniLM-L6-v2

# === App ===
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# Origins allowed to call the API from a browser (the Vite dev server by default).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Query Safety ===
MAX_QUERY_LIMIT=1000
QUERY_TIMEOUT_SECONDS=10
MAX_RETRY_ATTEMPTS=2
