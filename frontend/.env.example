# Base path the browser uses to reach the API.
# Leave as /api in development: the Vite dev server proxies it to FastAPI.
VITE_API_BASE_URL=/api

# Where the dev-server proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# NOTE: never put GROQ_API_KEY (or any secret) in this file. Everything with a
# VITE_ prefix is inlined into the JavaScript bundle and is public.
